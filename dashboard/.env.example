# Copy to `.env.local` (gitignored). Never put secrets on NEXT_PUBLIC_* vars.
# Local setup: docs/foundation/setup.md
# Amplify pilot: dashboard/amplify.env.example → amplify.env.local, then npm run amplify:sync-env
#   (docs/guides/operators/aws-pilot-runbook.md § 3)

# ── Control-layer proxy (required for /api/control/*) ─────────────────────────
# API: http://localhost:3000 (repo root: npm run dev)
# Dashboard: http://localhost:3001 (cd dashboard && npm run dev)
# Do not put both on the same port — docs/foundation/setup.md § Port conflict
CONTROL_LAYER_API_BASE_URL=http://localhost:3000
CONTROL_LAYER_API_KEY=

# Pins org for proxy/UI (e.g. springs after seed). Leave empty to pass org_id per request.
CONTROL_LAYER_ORG_ID=

# Server-only. Enables Settings → ingestion preflight dry-run (/api/preflight).
CONTROL_LAYER_ADMIN_API_KEY=

# ── Client labels (safe to expose) ────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME=Decision Panel

# Sidebar chip override. If unset: "Production" (prod build) or "Local" (dev).
# Example: Pilot — investor/demo framing without Amplify.
# NEXT_PUBLIC_ENVIRONMENT_LABEL=Pilot

# ── Feature flags ─────────────────────────────────────────────────────────────
# CSAT microsurvey — default OFF when unset. Spec: docs/specs/customer-feedback-loop.md
# NEXT_PUBLIC_FEEDBACK_CSAT=false
# NEXT_PUBLIC_CSAT_MIN_INTERVAL_DAYS=7
# NEXT_PUBLIC_FEEDBACK_TASK_DECISION_THRESHOLD=5

# Overview: chart↔table sync is always on. This flag only shows/hides the opt-out toggle.
# false = hide toggle (recommended). Unset or true = show toggle.
NEXT_PUBLIC_OVERVIEW_CROSS_FILTER=false

# Demo-only: fill empty educator_explanation with mock AI narratives (screenshots).
# Never enable for real customer environments.
# NEXT_PUBLIC_AI_EXPLANATIONS_DEMO=false

# ── Passphrase gate ───────────────────────────────────────────────────────────
# Spec: docs/specs/dashboard-passphrase-gate.md
# Gate off when all access codes are empty (typical local). COOKIE_SECRET required when gate on (min 32 chars: openssl rand -hex 32).
#
# Pick ONE profile (prefer exclusive — do not mix unless you want the warn + alias behavior):
#
# Profile A — local simple (full / compliance-equivalent nav):
#   DASHBOARD_ACCESS_CODE=dev-local
#
# Profile B — local persona (D5 educator vs compliance nav) — recommended:
#   DASHBOARD_ACCESS_CODE_EDUCATOR=demo-educator
#   DASHBOARD_ACCESS_CODE_COMPLIANCE=demo-compliance
#
# If both dual vars AND DASHBOARD_ACCESS_CODE are set: dual mode is active; legacy code
# still logs in as compliance (alias) and the server logs a one-time warning.
DASHBOARD_ACCESS_CODE=
# DASHBOARD_ACCESS_CODE_EDUCATOR=
# DASHBOARD_ACCESS_CODE_COMPLIANCE=
DASHBOARD_SESSION_TTL_HOURS=8
COOKIE_SECRET=
