# Amplify Console → Environment variables (SSR runtime — not client bundle).
# Copy from pilot vault; never commit secrets.
# Runbook: docs/guides/operators/aws-pilot-runbook.md § 3.2
# Sync: npm run amplify:sync-env (requires AMPLIFY_APP_ID)
# Full local var reference: dashboard/.env.example

# Control-layer proxy (required)
CONTROL_LAYER_API_BASE_URL=https://<api-id>.execute-api.us-east-1.amazonaws.com/pilot
CONTROL_LAYER_API_KEY=
CONTROL_LAYER_ORG_ID=southwest-charter

# Passphrase gate (required for pilot). COOKIE_SECRET min 32 chars: openssl rand -hex 32
# Prefer exclusive: dual educator+compliance (persona nav) OR only DASHBOARD_ACCESS_CODE (full nav).
# If both dual vars and legacy are set, legacy is a compliance alias + one-time warn (see setup.md).
DASHBOARD_ACCESS_CODE=
# DASHBOARD_ACCESS_CODE_EDUCATOR=
# DASHBOARD_ACCESS_CODE_COMPLIANCE=
COOKIE_SECRET=

# Optional
DASHBOARD_SESSION_TTL_HOURS=8
CONTROL_LAYER_ADMIN_API_KEY=
NEXT_PUBLIC_APP_NAME=Decision Panel
# Sidebar chip override (unset → "Production" on Amplify). Example: Pilot
# NEXT_PUBLIC_ENVIRONMENT_LABEL=Pilot
